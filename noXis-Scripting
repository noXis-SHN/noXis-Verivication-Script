-- ============================================
-- DRAG
-- ============================================
local function makeDraggable(frame)
    local drag, dStart, sPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            drag = true
            dStart = input.Position
            sPos = frame.Position
        end
    end)
    frame.InputChanged:Connect(function(input)
        if drag and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dStart
            frame.Position = UDim2.new(
                sPos.X.Scale, sPos.X.Offset + d.X,
                sPos.Y.Scale, sPos.Y.Offset + d.Y
            )
        end
    end)
    frame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            drag = false
        end
    end)
end

-- ============================================
-- BUTTON MAKER
-- ============================================
local function makeBtn(parent, text, size, pos, primary, txtSize)
    local b = Instance.new("TextButton")
    b.Size = size
    b.Position = pos
    b.BackgroundColor3 = primary and C.BtnOn or C.BtnOff
    b.Text = text
    b.TextColor3 = C.White
    b.TextSize = txtSize or 13
    b.Font = Enum.Font.GothamBold
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    b.TextWrapped = true
    b.Parent = parent

    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)

    local s = Instance.new("UIStroke", b)
    s.Color = primary and C.Red or C.DarkRed
    s.Thickness = 1.5

    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), {
            BackgroundColor3 = primary and C.Crimson or Color3.fromRGB(60, 15, 15)
        }):Play()
    end)
    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), {
            BackgroundColor3 = b:GetAttribute("IsOn") and C.BtnOn or C.BtnOff
        }):Play()
    end)

    return b, s
end

-- ============================================
-- FITUR: FREECAM
-- ============================================
local function enableFreecam()
    if freecamOn then return end
    freecamOn = true

    local cam = workspace.CurrentCamera
    local cf = cam.CFrame
    local rx, ry = 0, 0

    pcall(function()
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        UserInputService.MouseIconEnabled = false
    end)

    freecamConn = RunService.RenderStepped:Connect(function()
        if not freecamOn then return end
        local d = UserInputService:GetMouseDelta()
        rx = rx - d.X * 0.005
        ry = math.clamp(ry - d.Y * 0.005, -math.rad(89), math.rad(89))

        local mv = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then mv = mv + Vector3.new(0, 0, -1) end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then mv = mv + Vector3.new(0, 0, 1) end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then mv = mv + Vector3.new(-1, 0, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then mv = mv + Vector3.new(1, 0, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then mv = mv + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then mv = mv + Vector3.new(0, -1, 0) end

        local rot = CFrame.fromEulerAnglesYXZ(ry, rx, 0)
        cf = CFrame.new(cf.Position) * rot
        cf = cf + (cf:VectorToWorldSpace(mv) * 1.5)

        cam.CFrame = cf
        cam.Focus = cf
    end)
end

local function disableFreecam()
    if not freecamOn then return end
    freecamOn = false
    if freecamConn then
        freecamConn:Disconnect()
        freecamConn = nil
    end
    pcall(function()
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        UserInputService.MouseIconEnabled = true
    end)
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then Camera.CameraSubject = hum end
    end
end

-- ============================================
-- FITUR: LOCK
-- ============================================
local function lockChar()
    if lockOn then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    lockOn = true
    lockedCF = hrp.CFrame

    lockConn = RunService.RenderStepped:Connect(function()
        if not lockOn then return end
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h then return end
        if lockedCF then
            h.CFrame = CFrame.new(lockedCF.Position) * (h.CFrame - h.CFrame.Position)
        end
    end)

    pcall(function()
        local pm = LocalPlayer.PlayerScripts:FindFirstChild("PlayerModule")
        if pm then require(pm):GetControls():Disable() end
    end)
end

local function unlockChar()
    if not lockOn then return end
    lockOn = false
    lockedCF = nil
    if lockConn then
        lockConn:Disconnect()
        lockConn = nil
    end
    pcall(function()
        local pm = LocalPlayer.PlayerScripts:FindFirstChild("PlayerModule")
        if pm then require(pm):GetControls():Enable() end
    end)
end

-- ============================================
-- FITUR: MOVE
-- ============================================
local function moveChar(dir, amt)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local off = Vector3.new(0, 0, 0)
    if dir == "up" then off = Vector3.new(0, amt, 0)
    elseif dir == "down" then off = Vector3.new(0, -amt, 0)
    elseif dir == "left" then off = Vector3.new(-amt, 0, 0)
    elseif dir == "right" then off = Vector3.new(amt, 0, 0)
    elseif dir == "forward" then off = Vector3.new(0, 0, -amt)
    elseif dir == "backward" then off = Vector3.new(0, 0, amt)
    end

    hrp.CFrame = hrp.CFrame + off
    if lockedCF then lockedCF = hrp.CFrame end
end

